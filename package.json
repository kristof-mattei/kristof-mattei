{
    "name": "kristof-mattei",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.73.0"
    },
    "lint-staged": {
        "*.sh": [
            "shfmt --diff --apply-ignore --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.12.0"
    },
    "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4"
}
