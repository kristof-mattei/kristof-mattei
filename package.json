{
    "name": "kristof-mattei",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.72.0"
    },
    "lint-staged": {
        "*.sh": [
            "shfmt --diff --apply-ignore --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539"
}
